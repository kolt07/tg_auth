# Скопіюйте цей файл у .env і замініть ключі.
# Ключ Fernet:
# py -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Випадковий API_KEY:
# py -c "import secrets; print(secrets.token_urlsafe(24))"

API_KEY=change-me-please
SESSION_ENCRYPTION_KEY=

# Додаток з https://my.telegram.org — один на весь сервіс, у формі входу не потрібен
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

POSTGRES_USER=tgauth
POSTGRES_PASSWORD=tgauth
POSTGRES_DB=tgauth
DATABASE_URL=postgresql+asyncpg://tgauth:tgauth@postgres:5432/tgauth
REDIS_URL=redis://redis:6379/0

DEFAULT_PHONE_REGION=RU
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# HTTPS (Caddy). Локально: localhost + tls internal.
# Для Telegram Mini App потрібен публічний домен і валідний сертифікат:
#   PUBLIC_HOST=auth.example.com
#   CADDY_TLS_ARGS=
PUBLIC_HOST=localhost
CADDY_TLS_ARGS=tls internal
